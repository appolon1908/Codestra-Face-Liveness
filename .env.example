# Copy to .env for local development. Never commit .env or real secrets.
LIVENESS_ENV=development
LIVENESS_LOG_LEVEL=INFO
LIVENESS_MODEL_DIR=./models
LIVENESS_PORT=8080

# Model registry: extra installed versions as <registry dir>/*.json manifests.
# Empty active version = built-in version (1.0.0). Exactly one version is active.
# LIVENESS_MODEL_REGISTRY_DIR=./models/registry
LIVENESS_ACTIVE_MODEL_VERSION=
# Non-built-in active versions need a passing validation record (face-liveness-models
# validate) matching the threshold/calibration id below. Always on in production.
LIVENESS_REQUIRE_MODEL_VALIDATION=false

# Decision policy. Set both only from a reviewed calibration report for the ACTIVE
# model version (docs/OPERATIONS.md#calibration); reports are never applied automatically.
LIVENESS_LIVE_THRESHOLD=0.85
LIVENESS_THRESHOLD_CALIBRATION_ID=
# Explicit, versioned score-fusion policy. passive-and-active.v1 fails closed until a
# tested active provider exists.
LIVENESS_FUSION_POLICY_ID=passive-only.v1
# Active liveness provider id. None ships; any value keeps the service not-ready.
LIVENESS_ACTIVE_PROVIDER=

# Input / quality gates
LIVENESS_MAX_IMAGE_BYTES=5242880
LIVENESS_MAX_IMAGE_PIXELS=25000000
LIVENESS_MAX_IMAGE_SIDE_PX=8192
LIVENESS_MAX_DECODED_BYTES=201326592
LIVENESS_MIN_IMAGE_SIDE_PX=112
LIVENESS_MIN_FACE_SIZE_PX=64
LIVENESS_DETECTOR_SCORE_THRESHOLD=0.8
LIVENESS_SECONDARY_FACE_AREA_RATIO=0.0

# Capacity
LIVENESS_MAX_CONCURRENT_CHECKS=4
LIVENESS_MAX_QUEUED_CHECKS=8
LIVENESS_BUSY_TIMEOUT_SECONDS=2
LIVENESS_REQUEST_TIMEOUT_SECONDS=10
LIVENESS_ONNX_INTRA_OP_THREADS=2
# profile_id of the benchmark report these capacity settings were taken from (informational).
LIVENESS_CAPACITY_PROFILE_ID=

# Challenges (freshness / replay nonces; NOT active liveness). In-process store:
# Middleware V3 must route verify to the replica that issued the challenge.
LIVENESS_CHALLENGE_TTL_SECONDS=120
LIVENESS_MAX_OUTSTANDING_CHALLENGES=10000

# Caller auth (Middleware V3). Reference a file; never put the token value here in production.
LIVENESS_REQUIRE_AUTH=false
LIVENESS_API_TOKEN_FILE=./secrets/liveness_api_token
