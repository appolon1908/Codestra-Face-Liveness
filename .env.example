# Copy to .env for local development. Never commit .env or real secrets.
LIVENESS_ENV=development
LIVENESS_LOG_LEVEL=INFO
LIVENESS_MODEL_DIR=./models
LIVENESS_PORT=8080

# Decision policy (see docs/MODEL_CARD.md#calibration)
LIVENESS_LIVE_THRESHOLD=0.85
LIVENESS_THRESHOLD_CALIBRATION_ID=

# Input / quality gates
LIVENESS_MAX_IMAGE_BYTES=5242880
LIVENESS_MAX_IMAGE_PIXELS=25000000
LIVENESS_MIN_IMAGE_SIDE_PX=112
LIVENESS_MIN_FACE_SIZE_PX=64
LIVENESS_DETECTOR_SCORE_THRESHOLD=0.8
LIVENESS_SECONDARY_FACE_AREA_RATIO=0.0

# Capacity
LIVENESS_MAX_CONCURRENT_CHECKS=4
LIVENESS_BUSY_TIMEOUT_SECONDS=2
LIVENESS_ONNX_INTRA_OP_THREADS=2

# Caller auth (Middleware V3). Reference a file; never put the token value here in production.
LIVENESS_REQUIRE_AUTH=false
LIVENESS_API_TOKEN_FILE=./secrets/liveness_api_token
